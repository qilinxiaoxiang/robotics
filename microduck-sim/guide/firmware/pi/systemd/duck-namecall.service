[Unit]
Description=MicroDuck name response (audio from boot; guarded head response at rest)
After=duck-camera.service duck-selfcheck.service sound.target
[Service]
User=radxa
ExecStart=/home/radxa/.venvs/duck-policy/bin/python /home/radxa/rt/microduck-sim/guide/firmware/mac/namecall_boot.py
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
