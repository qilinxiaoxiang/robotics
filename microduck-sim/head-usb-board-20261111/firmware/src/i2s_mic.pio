; MicroDuck head USB board: I2S master receiver for three INMP441 microphones on two data lines.
; Original work for this project (BSD-3-Clause, see ../README.md, Licences). Not derived from any other I2S PIO program.
;
; Pins (sch/netlist.py): side-set base = MIC_SCK (GPIO10), base+1 = MIC_WS (GPIO11);
;                        in base   = MIC_SD_EARS (GPIO12), base+1 = MIC_SD_BACK (GPIO13).
; Clock: 2 PIO cycles per SCK period. With clk_sys 61.44 MHz and divider 10 the PIO runs at 6.144 MHz, so
;        SCK = 3.072 MHz = 64 x 48 kHz, exactly, with an integer divider (no fractional jitter).
;
; One SCK period is [SCK low, 1 cycle][SCK high, 1 cycle]. WS changes together with an SCK falling edge.
; The INMP441 changes SD after an SCK falling edge; the datasheet gives no output delay figure. "in pins" runs in
; the cycle that drives SCK low again, and the RP2040 input synchroniser makes it read the level from two clk_sys
; cycles earlier, i.e. the end of the high phase: the latest safe moment (about 293 ns after the edge that launched
; the bit).
;
; Numbering the 32 periods of a slot 0..31 (period 0 starts where WS changes), I2S puts the MSB in period 1.
; The "in" executed at the start of period k therefore reads the bit of period k-1, and the first "in" of a slot
; word must sit at period 2. The entry code below runs periods 0 and 1 of the first left slot without sampling, so
; that the 32-bit words leave in this fixed order, two data-line bits per SCK period (bit 0 ears, bit 1 back):
;   word 0: left slot,  sample bits 23..8      word 1: left slot,  sample bits 7..0, then 8 periods of don't-care
;   word 2: right slot, sample bits 23..8      word 3: right slot, sample bits 7..0, then 8 periods of don't-care
; In each word the ear line is on the even bits and the back line on the odd bits, MSB first.
; Autopush at 32 bits; a full RX FIFO stalls the state machine (clocks pause), so word order is never lost.

.program i2s_mic
.side_set 2                         ; bit 0 = SCK, bit 1 = WS

public entry:
    set x, 29           side 0b00   ; left period 0, low half (WS low = left)
    nop                 side 0b01   ; left period 0, high half
    nop                 side 0b00   ; left period 1, low half
    nop                 side 0b01   ; left period 1, high half
.wrap_target
left_loop:                          ; left periods 2..31 on the first pass, 1..31 afterwards
    in pins, 2          side 0b00
    jmp x-- left_loop   side 0b01
    in pins, 2          side 0b10   ; right period 0: WS rises with this SCK falling edge
    set x, 30           side 0b11
right_loop:                         ; right periods 1..31
    in pins, 2          side 0b10
    jmp x-- right_loop  side 0b11
    in pins, 2          side 0b00   ; left period 0: WS falls with this SCK falling edge
    set x, 30           side 0b01
.wrap
